rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /djs/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.djUid;

      match /requests/{requestId} {
        allow read: if true;
        allow create: if request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.artist is string
          && request.resource.data.artist.size() <= 200
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 100;
        allow update, delete: if request.auth != null;
      }

      match /suggestions/{suggId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 100
          && (!('votes' in request.resource.data) || request.resource.data.votes == 0);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes == resource.data.votes + 1;
      }
    }

    // Agenda date e preventivi DJ: privata, visibile solo al DJ proprietario
    match /bookings/{bookingId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.djUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.djUid;
    }
  }
}
